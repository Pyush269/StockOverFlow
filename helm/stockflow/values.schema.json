{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["backend", "frontend", "postgresql", "migrations", "autoscaling", "ingress", "monitoring"],
  "properties": {
    "imagePullSecrets": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}},
    "backend": {"$ref": "#/definitions/application"},
    "frontend": {"$ref": "#/definitions/application"},
    "postgresql": {
      "type": "object",
      "required": ["image", "existingSecret", "database", "username", "persistence", "resources"],
      "properties": {
        "image": {"type": "string", "pattern": "@sha256:[a-f0-9]{64}$"},
        "existingSecret": {"type": "string", "minLength": 1},
        "database": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
        "username": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
        "persistence": {"type": "object", "required": ["storageClass", "size"], "properties": {"storageClass": {"type": "string", "minLength": 1}, "size": {"type": "string", "pattern": "^[1-9][0-9]*Gi$"}}},
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "migrations": {"type": "object", "required": ["activeDeadlineSeconds", "resources"], "properties": {"activeDeadlineSeconds": {"type": "integer", "minimum": 240}, "resources": {"$ref": "#/definitions/resources"}}},
    "autoscaling": {"type": "object", "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"], "properties": {"enabled": {"type": "boolean"}, "minReplicas": {"type": "integer", "minimum": 2}, "maxReplicas": {"type": "integer", "minimum": 2, "maximum": 10}, "targetCPUUtilizationPercentage": {"type": "integer", "minimum": 10, "maximum": 95}}},
    "ingress": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "className": {"type": "string", "minLength": 1}, "host": {"type": "string"}, "annotations": {"type": "object", "additionalProperties": {"type": "string"}}}},
    "monitoring": {"type": "object"}
  },
  "definitions": {
    "application": {"type": "object", "required": ["image", "replicas", "resources"], "properties": {"replicas": {"type": "integer", "minimum": 2}, "image": {"type": "object", "required": ["repository", "tag", "pullPolicy"], "properties": {"repository": {"type": "string", "minLength": 1}, "tag": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "pullPolicy": {"enum": ["IfNotPresent", "Always"]}}}, "resources": {"$ref": "#/definitions/resources"}}},
    "resources": {"type": "object", "required": ["requests", "limits"], "properties": {"requests": {"type": "object", "required": ["cpu", "memory"]}, "limits": {"type": "object", "required": ["cpu", "memory"]}}}
  }
}
