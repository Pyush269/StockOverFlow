# Local development only. Change the password before starting PostgreSQL.
POSTGRES_DB=stockflow
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=replace_with_a_local_password
DATABASE_URL=postgresql+psycopg://stockflow:replace_with_a_local_password@localhost:5432/stockflow
# Explicitly allowed origins for direct Vite development. JSON array syntax.
CORS_ORIGINS=["http://localhost:5173"]
# Optional Compose host ports (all bind to 127.0.0.1).
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Runtime Nginx proxy target, never embedded in the frontend JavaScript.
API_UPSTREAM=backend:8000
# Docker's embedded DNS; use the cluster DNS address when deploying this proxy elsewhere.
NGINX_RESOLVER=127.0.0.11
